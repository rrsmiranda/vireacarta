# Métricas anônimas (Umami). Configure na Vercel em Settings → Environment Variables.
# Sem esta variável, nenhuma métrica é carregada (ex.: no desenvolvimento local).
VITE_UMAMI_WEBSITE_ID=
# Opcional: só se usar um Umami próprio em vez do Umami Cloud.
# VITE_UMAMI_SCRIPT_URL=https://seu-umami.exemplo.com/script.js
